{
  // نام باید دقیقاً با نام Worker در داشبورد Cloudflare یکی باشد
  "name": "khanifarweb-ir",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // درخواست‌های API قبل از فایل‌های استاتیک به Worker می‌رسند
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
