---
/** لوگوی KhanifarWeb: نماد «چشم» (دیده‌شدن) + نوشتار. */
interface Props { light?: boolean }
const { light = false } = Astro.props;
---

<span class:list={["logo", { "logo--light": light }]}>
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="#2563eb" />
    <path d="M5 16Q16 2 27 16Q16 30 5 16Z" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round" />
    <circle cx="16" cy="16" r="3.6" fill="#fff" />
  </svg>
  <span class="logo__text ltr">Khanifar<b>Web</b></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: var(--s-2); }
  .logo__text { font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em; color: var(--text); }
  .logo__text b { color: var(--accent); font-weight: 800; }
  .logo--light .logo__text { color: #fff; }
  .logo--light .logo__text b { color: var(--accent-on-ink); }
</style>
