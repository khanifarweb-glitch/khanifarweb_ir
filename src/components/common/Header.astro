---
/** هدر: لوگوی متنی، منوی اصلی، CTA و کلید تغییر زبان. منوی موبایل با JS کوچک (progressive enhancement). */
import { siteFor } from "../../data/site";
import { alternateOf, languages, useI18n } from "../../i18n/ui";
import { visibleNav } from "../../utils/content";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

const { lang, t, lp } = useI18n(Astro.url);
const site = siteFor(lang);
const nav = await visibleNav(lang);
const alt = alternateOf(Astro.url); // همین صفحه در زبان دیگر
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="header" data-header>
  <div class="container header__bar">
    <a class="brand" href={lp("/")} aria-label={`${site.name} - ${t.common.homeAria}`}><Logo light /></a>

    <div class="header__tools">
      <!-- کلید زبان: لینک ساده به همان صفحه در زبان دیگر (بدون JS) -->
      <a class="lang-switch" href={alt.href} hreflang={alt.other} lang={alt.other} data-lang-switch>{languages[alt.other].label}</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="main-nav"
        data-menu-btn
      >
        {t.common.menu}
      </button>
    </div>

    <nav class="nav" id="main-nav" aria-label={t.common.mainNav} data-nav>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href={site.primaryCta.href} variant="gold" class="nav__cta">{site.primaryCta.label}</Button>
    </nav>
  </div>
</header>

<script>
  // باز و بسته شدن منوی موبایل؛ بدون JS منو همیشه نمایش داده می‌شود
  const header = document.querySelector<HTMLElement>("[data-header]");
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (header && btn && nav) {
    header.dataset.js = "";
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      nav.toggleAttribute("data-open", open);
    };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { set(false); btn.focus(); }
    });
  }
</script>

<style>
  /* نوار تیره سرمه‌ای + جزئیات طلایی (هم‌تم با nedakhanifar.com) */
  .header { position: sticky; top: 0; z-index: 50; background: rgb(14 27 44 / 0.96); color: var(--on-ink); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .header__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-3); }
  .brand { text-decoration: none; }
  .header__tools { display: flex; align-items: center; gap: var(--s-2); }
  .lang-switch { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--s-4); border: 1px solid rgb(122 162 255 / 0.5); border-radius: var(--radius-sm); font-size: var(--fs-sm); font-weight: 600; color: var(--gold-on-ink); text-decoration: none; transition: background-color var(--ease), color var(--ease); }
  .lang-switch:hover { background: var(--gold-on-ink); color: var(--ink); }
  .menu-btn { display: none; min-height: 2.75rem; padding: 0 var(--s-4); background: transparent; color: #fff; border: 1px solid rgb(255 255 255 / 0.3); border-radius: var(--radius-sm); cursor: pointer; font-weight: 600; }
  .nav { display: flex; flex-direction: column; gap: var(--s-4); width: 100%; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .nav a:not(.btn) { display: block; padding: var(--s-3) 0; text-decoration: none; color: var(--on-ink-muted); font-weight: 600; transition: color var(--ease); }
  .nav a:not(.btn):hover, .nav a[aria-current="page"] { color: #fff; }
  @media (min-width: 64rem) { .nav a[aria-current="page"] { box-shadow: 0 2px 0 var(--gold-on-ink); } }

  /* موبایل با JS: منو جمع‌شونده */
  @media (max-width: 63.99rem) {
    [data-js] .menu-btn { display: inline-flex; align-items: center; }
    [data-js] .nav:not([data-open]) { display: none; }
  }
  @media (min-width: 64rem) {
    .nav { flex-direction: row; align-items: center; width: auto; gap: var(--s-6); order: 2; }
    .header__tools { order: 3; }
    .lang-switch { min-height: 2.5rem; }
    .nav ul { flex-direction: row; gap: var(--s-6); }
    .nav a:not(.btn) { padding: var(--s-2) 0; font-size: var(--fs-sm); }
    .nav :global(.nav__cta) { min-height: 2.5rem; padding: 0 var(--s-4); }
  }
</style>
