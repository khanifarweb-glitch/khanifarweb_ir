---
/** کارت ساده. با href کل کارت لینک می‌شود. */
interface Props {
  href?: string;
  class?: string;
}
const { href, class: extra = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["card", { "card--link": !!href }, extra]} href={href}>
  <slot />
</Tag>

<style>
  .card {
    display: block; padding: var(--s-6);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-md); box-shadow: var(--shadow-sm);
    color: inherit; text-decoration: none;
  }
  .card--link { transition: transform var(--ease), border-color var(--ease); }
  .card--link:hover { transform: translateY(-2px); border-color: var(--accent); }
</style>
