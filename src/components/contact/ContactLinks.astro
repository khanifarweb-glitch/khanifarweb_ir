---
/** راه‌های ارتباط مستقیم؛ فقط مقدارهای پرشده در site.ts نمایش داده می‌شوند. */
import Icon from "../common/Icon.astro";
import { site } from "../../data/site";
import { useI18n } from "../../i18n/ui";

const c = useI18n(Astro.url).t.contactLinks;
const { phone, email, whatsapp, telegram } = site.contact;
const items = [
  phone && { icon: "phone", label: c.phone, value: phone, href: `tel:${phone}`, ltr: true },
  whatsapp && { icon: "chat", label: c.whatsapp, value: c.whatsappValue, href: whatsapp },
  telegram && { icon: "send", label: c.telegram, value: c.telegramValue, href: telegram },
  email && { icon: "mail", label: c.email, value: email, href: `mailto:${email}`, ltr: true },
].filter(Boolean) as { icon: "phone" | "chat" | "send" | "mail"; label: string; value: string; href: string; ltr?: boolean }[];
---

{items.length > 0 && (
  <ul class="links">
    {items.map((i) => (
      <li>
        <a href={i.href} rel={i.href.startsWith("http") ? "noopener" : undefined}>
          <span class="ico"><Icon name={i.icon} size={20} /></span>
          <span class="txt"><small>{i.label}</small><b class:list={{ ltr: i.ltr }}>{i.value}</b></span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); }
  a { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); text-decoration: none; transition: border-color var(--ease), box-shadow var(--ease); }
  a:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
  .ico { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  .txt { display: grid; line-height: 1.5; }
  small { color: var(--muted); }
  b { font-weight: 700; }
</style>
