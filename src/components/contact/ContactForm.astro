---
/** فرم درخواست مشاوره: نام، شماره تماس، نوع خدمت، توضیح کوتاه. ارسال با fetch به /api/contact */
import Button from "../common/Button.astro";
import { useI18n } from "../../i18n/ui";

const { lang, t } = useI18n(Astro.url);
const f = t.form;

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY; // اختیاری
---

<form
  class="form"
  data-contact-form
  method="post"
  action="/api/contact"
  data-lang={lang}
  data-sending={f.sending}
  data-ok={f.ok}
  data-err404={f.err404}
  data-err-default={f.errDefault}
  data-err-code={f.errCode}
  data-err-network={f.errNetwork}
>
  <div class="field">
    <label for="name">{f.name}</label>
    <input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" />
  </div>

  <div class="field">
    <label for="phone">{f.phone}</label>
    <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required maxlength="20" pattern="[0-9۰-۹٠-٩+\s\-()]{10,20}" title={f.phoneTitle} placeholder={f.phonePlaceholder} />
  </div>

  <div class="field">
    <label for="service">{f.service}</label>
    <select id="service" name="service" required>
      <option value="design">{f.design}</option>
      <option value="website-support">{f.support}</option>
      <option value="ai">{f.ai}</option>
      <option value="other">{f.other}</option>
    </select>
  </div>

  <div class="field">
    <label for="message">{f.message} <span class="opt">{f.optional}</span></label>
    <textarea id="message" name="message" rows="4" maxlength="1000"></textarea>
  </div>

  <!-- Honeypot: برای انسان نامرئی است -->
  <div class="hp" inert>
    <label for="website">{f.honeypot}</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}

  <Button type="submit" size="lg">{f.submit}</Button>
  <p class="status" role="status" aria-live="polite" data-status></p>
  <noscript><p>{f.noscript}</p></noscript>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const msg = form.dataset; // متن‌ها (به زبان صفحه) از data-attributeهای فرم می‌آیند
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const select = form.elements.namedItem("service") as HTMLSelectElement;
    let t0 = performance.now(); // زمان پر کردن فرم (ضد ربات)؛ مستقل از ساعت دستگاه

    // انتخاب خودکار خدمت از آدرس: /contact/?service=ai
    const wanted = new URLSearchParams(location.search).get("service");
    if (wanted && [...select.options].some((o) => o.value === wanted)) select.value = wanted;

    const show = (msg: string, isError: boolean) => {
      status.textContent = msg; // textContent: بدون خطر XSS
      status.dataset.error = String(isError);
      status.setAttribute("role", isError ? "alert" : "status"); // خطا فوراً توسط صفحه‌خوان اعلام شود
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = msg.sending ?? "";
      show("", false);
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), lang: msg.lang, elapsed: Math.round(performance.now() - t0) }),
        });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.ok) {
          form.reset();
          t0 = performance.now();
          show(msg.ok ?? "", false);
        } else {
          const code = data?.code ?? `HTTP ${res.status}`;
          const base = data?.error ?? (res.status === 404 ? msg.err404 : msg.errDefault);
          show(data?.code === "validation" ? base : `${base} (${msg.errCode}: ${code})`, true);
        }
      } catch {
        show(msg.errNetwork ?? "", true);
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>

<style>
  .form { display: grid; gap: var(--s-6); padding: var(--s-6); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .field { display: grid; gap: var(--s-2); }
  label { font-weight: 600; }
  .opt { font-weight: 400; color: var(--muted); font-size: var(--fs-sm); }
  input, select, textarea {
    width: 100%; min-height: 3rem; padding: var(--s-3) var(--s-4);
    background: var(--surface); border: 1px solid #9ca3af; border-radius: var(--radius-sm);
  }
  textarea { resize: vertical; }
  .hp { position: absolute; inset-inline-start: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status { min-height: 1.5em; font-weight: 600; }
  .status[data-error="false"] { color: #047857; }
  .status[data-error="true"] { color: #b91c1c; }
  .form :global(.btn) { justify-self: start; }
  .form :global(.btn:disabled) { opacity: 0.6; cursor: wait; }
</style>
