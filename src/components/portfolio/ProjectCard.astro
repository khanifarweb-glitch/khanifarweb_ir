---
/** کارت پروژه: تصویر بهینه (WebP خودکار)، نوع، خدمات و توضیح کوتاه. */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "../common/Card.astro";
import { useI18n } from "../../i18n/ui";
import { projectText } from "../../utils/content";

interface Props { project: CollectionEntry<"portfolio"> }
const { project } = Astro.props;
const { lang, lp } = useI18n(Astro.url);
const d = { ...project.data, ...projectText(project, lang) };
---

<Card href={lp(`/portfolio/${project.id}/`)}>
  <Image
    src={d.image}
    alt={d.imageAlt}
    widths={[400, 800]}
    sizes="(min-width: 48rem) 33vw, 100vw"
    loading="lazy"
    class="thumb"
  />
  <p class="type">{d.type}</p>
  <h3>{d.title}</h3>
  <p class="summary">{d.summary}</p>
</Card>

<style>
  .thumb { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: var(--s-4); }
  .type { font-size: var(--fs-sm); color: var(--accent); font-weight: 600; }
  h3 { margin-block: var(--s-1) var(--s-2); }
  .summary { color: var(--muted); }
</style>
