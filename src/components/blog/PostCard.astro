---
import type { CollectionEntry } from "astro:content";
import Card from "../common/Card.astro";
import { formatPersianDate, toIsoDateTime } from "../../utils/date";

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const d = post.data;
---

<Card href={`/blog/${post.id}/`}>
  {d.image && <img class="thumb" src={d.image} alt={d.imageAlt ?? ""} width="600" height="338" loading="lazy" decoding="async" />}
  <p class="meta">
    <span>{d.category}</span> ·
    <time datetime={toIsoDateTime(d.date)}>{formatPersianDate(d.date)}</time>
  </p>
  <h3>{d.title}</h3>
  <p class="desc">{d.description}</p>
</Card>

<style>
  /* قاب ثابت ۱۶:۹؛ تصویر کامل و بدون برش دیده می‌شود */
  .thumb { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; padding: var(--s-2); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm, 8px); margin-bottom: var(--s-3); }
  .meta { font-size: var(--fs-sm); color: var(--muted); }
  h3 { margin-block: var(--s-2); }
  .desc { color: var(--muted); }
</style>
