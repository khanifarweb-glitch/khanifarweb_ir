---
/**
 * نمونهٔ زندهٔ «دیده‌شدن»: بازدیدکننده نوع کسب‌وکارش را می‌نویسد و می‌بیند سایتش در نتیجهٔ جستجو چه شکلی می‌شود.
 * بدون JavaScript هم کار می‌کند (نمونهٔ ثابت). متن فقط با textContent عوض می‌شود (امن در برابر XSS).
 */
import Icon from "../common/Icon.astro";
import { useI18n } from "../../i18n/ui";

const v = useI18n(Astro.url).t.heroVisual;
const title = v.titleTpl.replace("{q}", v.sample);
---

<div class="demo" data-demo data-tpl={v.titleTpl} data-sample={v.sample}>
  <div class="serp">
    <label class="bar">
      <span class="sr-only">{v.label}</span>
      <Icon name="search" size={18} />
      <input type="text" dir="auto" maxlength="40" autocomplete="off" placeholder={v.sample} />
    </label>

    <div class="res res--you">
      <span class="badge">{v.badge}</span>
      <div class="res__url"><span class="fav"><Icon name="eye" size={14} /></span><span class="ltr">{v.url}</span></div>
      <p class="res__title" data-title>{title}</p>
      <p class="res__desc">{v.desc}</p>
    </div>

    <div class="res res--dim" aria-hidden="true"><i class="w40"></i><i class="w90"></i><i class="w65"></i></div>
    <div class="res res--dim" aria-hidden="true"><i class="w50"></i><i class="w80"></i></div>
  </div>
  <p class="chip"><span class="dot"></span>{v.chip}</p>
</div>

<style>
  .demo { position: relative; width: 100%; max-width: 28rem; margin-inline: auto; }
  .serp { display: grid; gap: var(--s-3); padding: var(--s-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .bar { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-4); background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--muted); cursor: text; }
  .bar:focus-within { border-color: var(--accent); }
  .bar input { flex: 1; min-width: 0; padding: var(--s-1) 0; background: none; border: 0; outline: 0; color: var(--text); font-size: var(--fs-base); }
  .bar input::placeholder { color: var(--muted); opacity: 1; }
  .bar:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }

  .res { padding: var(--s-4); border-radius: var(--radius-md); }
  .res--you { position: relative; background: var(--accent-soft); border: 1.5px solid var(--accent); }
  .badge { position: absolute; top: -0.7rem; inset-inline-end: var(--s-4); padding: 0 var(--s-3); background: var(--accent); color: #fff; font-size: var(--fs-sm); font-weight: 700; border-radius: var(--radius-sm); }
  .res__url { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-sm); color: var(--muted); }
  .fav { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--accent); color: #fff; }
  .res__title { margin-top: var(--s-2); font-weight: 800; color: var(--accent-hover); overflow-wrap: anywhere; }
  .res__desc { margin-top: var(--s-1); font-size: var(--fs-sm); color: var(--muted); line-height: 1.7; }
  .res--dim { display: grid; gap: var(--s-2); opacity: 0.7; }
  .res--dim i { display: block; height: 0.5rem; border-radius: 999px; background: var(--border); }
  .w40 { width: 40%; } .w50 { width: 50%; } .w65 { width: 65%; } .w80 { width: 80%; } .w90 { width: 90%; }

  .chip { position: absolute; bottom: -1.25rem; inset-inline-start: -0.5rem; display: flex; align-items: center; gap: var(--s-2); margin: 0; padding: var(--s-2) var(--s-4); background: var(--ink); color: var(--on-ink); border-radius: var(--radius-sm); font-size: var(--fs-sm); font-weight: 700; }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: #4ade80; }

  /* تنها حرکت غیرکاربری صفحه: نتیجهٔ شما بعد از تایپ نمونه، یک‌بار برجسته می‌شود */
  @media (prefers-reduced-motion: no-preference) {
    .res--you { animation: land 0.7s 1.6s ease-out both; }
    @keyframes land { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent); } to { box-shadow: 0 0 0 0.9rem transparent; } }
  }
</style>

<script>
  // تایپ خودکار نمونه (فقط یک‌بار)؛ با اولین تعامل کاربر متوقف می‌شود
  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("input")!;
    const title = root.querySelector<HTMLElement>("[data-title]")!;
    const { tpl = "", sample = "" } = root.dataset;
    const render = () => { title.textContent = tpl.replace("{q}", input.value.trim() || sample); };

    let timer = 0;
    const stop = () => window.clearInterval(timer);
    input.addEventListener("focus", stop);
    input.addEventListener("input", () => { stop(); render(); });

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      input.value = sample; render();
    } else {
      let i = 0;
      timer = window.setInterval(() => {
        input.value = sample.slice(0, ++i); render();
        if (i >= sample.length) stop();
      }, 70);
    }
  }
</script>
