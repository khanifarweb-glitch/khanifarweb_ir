---
import Section from "../common/Section.astro";
import Button from "../common/Button.astro";
import Icon from "../common/Icon.astro";

const items = [
  { title: "خدمات AI", text: "استفاده از هوش مصنوعی برای حل مسائل واقعی کسب‌وکار." },
  { title: "آموزش AI", text: "آموزش ساده و کاربردی ابزارهای هوش مصنوعی." },
  { title: "مشاوره AI", text: "بررسی فرآیندهای کاری و پیشنهاد روش‌های استفاده از AI برای افزایش سرعت و بهره‌وری." },
];
---

<Section id="ai" tone="dark" eyebrow="هوش مصنوعی" title="هوش مصنوعی برای کار روزمره" intro="بدون وعده‌های بزرگ؛ فقط استفاده کاربردی که در کارتان صرفه‌جویی ایجاد کند.">
  <div class="grid">
    {items.map((i) => (
      <div class="item reveal">
        <span class="ico"><Icon name="ai" size={22} /></span>
        <h3>{i.title}</h3>
        <p>{i.text}</p>
      </div>
    ))}
  </div>
  <div class="more"><Button href="/ai/" variant="light" arrow>خدمات هوش مصنوعی</Button></div>
</Section>

<style>
  .grid { display: grid; gap: var(--s-4); }
  .item { padding: var(--s-6); background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1); border-radius: var(--radius-lg); }
  .ico { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: var(--s-4); color: var(--accent-on-ink); background: rgb(122 162 255 / 0.12); border-radius: var(--radius-md); }
  h3 { margin-bottom: var(--s-2); color: #fff; }
  p { color: var(--on-ink-muted); }
  .more { margin-top: var(--s-8); }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(3, 1fr); gap: var(--s-6); } }
</style>
