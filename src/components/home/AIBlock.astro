---
import Section from "../common/Section.astro";
import Button from "../common/Button.astro";
import Icon from "../common/Icon.astro";
import { useI18n } from "../../i18n/ui";

const { t, lp } = useI18n(Astro.url);
const a = t.aiBlock;
const items = a.items;
---

<Section id="ai" tone="dark" eyebrow={a.eyebrow} title={a.title} intro={a.intro}>
  <div class="grid">
    {items.map((i) => (
      <div class="item reveal">
        <span class="ico"><Icon name="ai" size={22} /></span>
        <h3>{i.title}</h3>
        <p>{i.text}</p>
      </div>
    ))}
  </div>
  <div class="more"><Button href={lp("/ai/")} variant="light" arrow>{a.cta}</Button></div>
</Section>

<style>
  .grid { display: grid; gap: var(--s-4); }
  .item { padding: var(--s-6); background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1); border-radius: var(--radius-lg); }
  .ico { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: var(--s-4); color: var(--accent-on-ink); background: rgb(122 162 255 / 0.16); border-radius: var(--radius-md); }
  h3 { margin-bottom: var(--s-2); color: #fff; }
  p { color: var(--on-ink-muted); }
  .more { margin-top: var(--s-8); }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(3, 1fr); gap: var(--s-6); } }
</style>
