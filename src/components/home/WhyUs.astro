---
import Section from "../common/Section.astro";
import Icon from "../common/Icon.astro";
import { useI18n } from "../../i18n/ui";

const w = useI18n(Astro.url).t.why;
const reasons = w.reasons;
---

<Section id="why" eyebrow={w.eyebrow} title={w.title}>
  <ul class="list">
    {reasons.map((r) => (
      <li class="reveal"><span class="tick"><Icon name="check" size={16} /></span>{r}</li>
    ))}
  </ul>
</Section>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4) var(--s-8); }
  li { display: flex; align-items: center; gap: var(--s-3); padding-block: var(--s-3); border-bottom: 1px solid var(--border); font-weight: 600; }
  .tick { flex: none; display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  @media (min-width: 48rem) { .list { grid-template-columns: repeat(2, 1fr); } }
</style>
