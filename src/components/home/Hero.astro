---
import { siteFor } from "../../data/site";
import { useI18n } from "../../i18n/ui";

import Button from "../common/Button.astro";
import HeroVisual from "./HeroVisual.astro";
import Avatar from "../common/Avatar.astro";
import { hasEntries } from "../../utils/content";

const { lang, t, lp } = useI18n(Astro.url);
const site = siteFor(lang);
const hasWork = await hasEntries("portfolio");
const points = t.hero.points;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title">{site.slogan}</h1>
      <p class="hero__lead">{site.description}</p>
      <div class="hero__actions">
        <Button href={site.primaryCta.href} size="lg" arrow>{site.primaryCta.label}</Button>
        {hasWork
          ? <Button href={lp("/portfolio/")} variant="secondary" size="lg">{t.hero.portfolio}</Button>
          : <Button href="#services" variant="secondary" size="lg">{t.hero.services}</Button>}
      </div>
      <a class="owner" href={lp("/about/")}>
        <Avatar size={48} />
        <span><b>{site.owner}</b><small>{t.hero.ownerRole}</small></span>
      </a>
      <ul class="hero__points">
        {points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <HeroVisual />
  </div>
</section>

<style>
  .hero { padding-block: var(--s-12) var(--s-16); }
  .hero__grid { display: grid; gap: var(--s-16); align-items: center; }
  h1 { max-width: 14ch; letter-spacing: 0; }
  .hero__lead { margin-top: var(--s-6); max-width: 50ch; font-size: var(--fs-lg); color: var(--muted); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-8); }
  .owner { display: inline-flex; align-items: center; gap: var(--s-3); margin-top: var(--s-8); text-decoration: none; }
  .owner span { display: grid; line-height: 1.5; }
  .owner b { text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 0.35em; transition: text-decoration-color var(--ease); }
  .owner:hover b { text-decoration-color: var(--accent); }
  .owner small { color: var(--muted); font-size: var(--fs-sm); }
  .hero__points { list-style: none; margin: var(--s-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) 0; color: var(--muted); font-size: var(--fs-sm); }
  .hero__points li { padding-inline: var(--s-4); border-inline-start: 1px solid var(--border); }
  .hero__points li:first-child { padding-inline-start: 0; border-inline-start: 0; }
  @media (min-width: 64rem) {
    .hero { padding-block: var(--s-24); }
    .hero__grid { grid-template-columns: 7fr 5fr; gap: var(--s-12); }
  }
</style>
