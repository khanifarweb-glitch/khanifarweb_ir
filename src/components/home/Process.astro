---
import Section from "../common/Section.astro";
import { useI18n } from "../../i18n/ui";

// این‌جا شماره‌گذاری درست است چون مراحل واقعاً پشت‌سرهم‌اند
const p = useI18n(Astro.url).t.process;
const steps = p.steps;
---

<Section id="process" title={p.title} intro={p.intro}>
  <ol class="steps">
    {steps.map((s) => (
      <li>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-8); counter-reset: step; }
  li { counter-increment: step; padding-top: var(--s-4); border-top: 2px solid var(--border); }
  li::before { content: counter(step, persian); /* در انگلیسی: عدد لاتین */ display: block; margin-bottom: var(--s-2); font-size: var(--fs-h2); font-weight: 900; line-height: 1; color: var(--accent); }
  :global(html[lang="en"]) li::before { content: counter(step); }
  h3 { font-weight: 800; }
  p { margin-top: var(--s-1); color: var(--muted); }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(4, 1fr); gap: var(--s-6); } }
</style>
