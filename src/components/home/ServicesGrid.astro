---
import Section from "../common/Section.astro";
import Icon from "../common/Icon.astro";
import { useI18n } from "../../i18n/ui";

// سه خدمت به‌صورت ردیف‌های لینک‌دار؛ «for» به بازدیدکننده کمک می‌کند خودش را پیدا کند (متن‌ها در src/i18n/ui.ts)
const { t, lp } = useI18n(Astro.url);
const sv = t.services;
const services = sv.items;
---

<Section id="services" title={sv.title} intro={sv.intro}>
  <ul class="rows">
    {services.map((s) => (
      <li>
        <a class="row" href={lp(s.href)}>
          <span class="for">{s.for}</span>
          <span class="body">
            <h3>{s.title}</h3>
            <span class="text">{s.text}</span>
          </span>
          <span class="cta">{s.cta}<Icon name="arrow" size={16} /></span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--border); }
  .row { display: grid; gap: var(--s-2); padding: var(--s-6) var(--s-2); color: inherit; text-decoration: none; transition: background-color var(--ease); }
  .row:hover { background: var(--accent-soft); }
  .for { font-size: var(--fs-sm); font-weight: 700; color: var(--accent-hover); }
  .body { display: grid; gap: var(--s-1); }
  h3 { font-weight: 800; }
  .text { color: var(--muted); max-width: 52ch; }
  .cta { display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-2); font-weight: 700; color: var(--accent); }
  .cta :global(svg) { transition: transform var(--ease); }
  .row:hover .cta :global(svg) { transform: scaleX(var(--arrow-flip)) translateX(-4px); }
  @media (min-width: 48rem) {
    .row { grid-template-columns: 13rem 1fr auto; align-items: baseline; gap: var(--s-8); padding-inline: var(--s-4); }
    .cta { margin-top: 0; }
  }
</style>
