---
import { siteFor } from "../../data/site";
import { useI18n } from "../../i18n/ui";

import Button from "../common/Button.astro";
const { lang, t } = useI18n(Astro.url);
const site = siteFor(lang);
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container band">
    <div>
      <h2 id="cta-title">{t.finalCta.title}</h2>
      <p>{t.finalCta.text}</p>
    </div>
    <Button href={site.primaryCta.href} variant="light" size="lg" arrow>{site.primaryCta.label}</Button>
  </div>
</section>

<style>
  .cta { margin-top: var(--s-16); padding-block: var(--s-12); background: var(--ink); color: var(--on-ink); }
  .band { display: grid; gap: var(--s-6); align-items: center; }
  p { margin-top: var(--s-3); max-width: 48ch; color: var(--on-ink-muted); }
  @media (min-width: 48rem) {
    .cta { padding-block: var(--s-16); }
    .band { grid-template-columns: 1fr auto; gap: var(--s-12); }
  }
</style>
