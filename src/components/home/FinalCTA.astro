---
import { site } from "../../data/site";
import Button from "../common/Button.astro";
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <h2 id="cta-title">آماده‌اید بیشتر دیده شوید؟</h2>
    <p>نیازتان را بنویسید تا با هم بررسی کنیم چه راهی برای کسب‌وکار شما مناسب‌تر است.</p>
    <Button href={site.primaryCta.href}>{site.primaryCta.label}</Button>
  </div>
</section>

<style>
  .cta { padding-block: var(--s-16); text-align: center; }
  p { margin: var(--s-3) auto var(--s-8); max-width: 48ch; color: var(--muted); }
</style>
