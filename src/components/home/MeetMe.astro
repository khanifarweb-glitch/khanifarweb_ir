---
import { siteFor } from "../../data/site";
import { fmt, useI18n } from "../../i18n/ui";
import Avatar from "../common/Avatar.astro";
import Button from "../common/Button.astro";

const { lang, t, lp } = useI18n(Astro.url);
const site = siteFor(lang);
---

<section class="meet-wrap" aria-labelledby="meet-title">
  <div class="container">
    <div class="meet reveal">
      <Avatar size={112} alt={site.owner} lazy />
      <div class="meet__text">
        <p class="meet__eyebrow">{t.meet.eyebrow}</p>
        <h2 id="meet-title">{fmt(t.meet.title, { name: site.owner.split(" ")[0] })}</h2>
        <p>{t.meet.text}</p>
        <div class="meet__actions">
          <Button href={site.primaryCta.href} arrow>{site.primaryCta.label}</Button>
          <Button href={lp("/about/")} variant="secondary">{t.meet.more}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .meet-wrap { padding-block: var(--s-16) 0; }
  .meet { display: grid; gap: var(--s-6); justify-items: start; padding: var(--s-8) var(--s-6); background: var(--warm-soft); border: 1px solid var(--warm-border); border-radius: var(--radius-lg); }
  .meet__eyebrow { font-size: var(--fs-sm); font-weight: 700; color: var(--warm-ink); }
  h2 { margin: var(--s-1) 0 var(--s-3); }
  .meet__text p:not(.meet__eyebrow) { max-width: 60ch; color: #4b4136; }
  .meet__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  @media (min-width: 48rem) { .meet { grid-template-columns: auto 1fr; align-items: center; gap: var(--s-8); padding: var(--s-12) var(--s-12); } }
</style>
