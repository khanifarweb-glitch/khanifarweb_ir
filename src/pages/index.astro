---
// صفحه اصلی: ترتیب بخش‌ها طبق Design Brief. بخش نمونه‌کار پس از افزودن پروژه‌های واقعی اضافه می‌شود.
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Hero from "../components/home/Hero.astro";
import ServicesGrid from "../components/home/ServicesGrid.astro";
import WhyUs from "../components/home/WhyUs.astro";
import Process from "../components/home/Process.astro";
import AIBlock from "../components/home/AIBlock.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import { site } from "../data/site";

const { phone, email, whatsapp, telegram } = site.contact;

// Schema فقط با اطلاعات واقعی؛ فیلدهای خالی حذف می‌شوند
const schema = [
  { "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: site.url, inLanguage: "fa-IR" },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: site.name,
    url: site.url,
    description: site.description,
    founder: { "@type": "Person", name: site.owner },
    ...(phone && { telephone: phone }),
    ...(email && { email }),
    ...([whatsapp, telegram].filter(Boolean).length && { sameAs: [whatsapp, telegram].filter(Boolean) }),
  },
];
---

<BaseLayout>
  <JsonLd slot="head" data={schema} />
  <Hero />
  <ServicesGrid />
  <WhyUs />
  <Process />
  <AIBlock />
  <FinalCTA />
</BaseLayout>
