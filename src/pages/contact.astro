---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/common/Section.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactLinks from "../components/contact/ContactLinks.astro";
import { site } from "../data/site";

const { phone, email, whatsapp, telegram } = site.contact;
const hasContact = phone || email || whatsapp || telegram;
---

<PageLayout
  title="درخواست مشاوره"
  description="برای طراحی سایت، پشتیبانی سایت یا خدمات هوش مصنوعی درخواست مشاوره بدهید. نیازتان را کوتاه بنویسید."
  lead="نیازتان را کوتاه بنویسید تا با هم بررسی کنیم چه راهی مناسب‌تر است."
  crumbs={[{ label: "درخواست مشاوره" }]}
>
  <Section>
    <div class="layout">
      <ContactForm />
      {hasContact && (
        <aside aria-labelledby="direct-title">
          <h2 id="direct-title">ترجیح می‌دهید مستقیم صحبت کنیم؟</h2>
          <ContactLinks />
        </aside>
      )}
    </div>
  </Section>
</PageLayout>

<style>
  .layout { display: grid; gap: var(--s-12); max-width: 56rem; }
  aside h2 { font-size: var(--fs-h3); margin-bottom: var(--s-4); }
  @media (min-width: 64rem) { .layout:has(aside) { grid-template-columns: 1.4fr 1fr; max-width: none; align-items: start; } }
</style>
