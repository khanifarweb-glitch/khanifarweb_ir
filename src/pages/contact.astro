---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/common/Section.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { site } from "../data/site";

const { phone, email, whatsapp, telegram } = site.contact;
const hasContact = phone || email || whatsapp || telegram;
---

<PageLayout
  title="درخواست مشاوره"
  description="برای طراحی سایت، پشتیبانی سایت یا خدمات هوش مصنوعی درخواست مشاوره بدهید. نیازتان را کوتاه بنویسید."
  lead="نیازتان را کوتاه بنویسید تا با هم بررسی کنیم چه راهی مناسب‌تر است."
  crumbs={[{ label: "درخواست مشاوره" }]}
>
  <Section>
    <div class="layout">
      <ContactForm />
      {hasContact && (
        <aside aria-labelledby="direct-title">
          <h2 id="direct-title">ارتباط مستقیم</h2>
          <ul>
            {phone && <li>تماس: <a class="ltr" href={`tel:${phone}`}>{phone}</a></li>}
            {email && <li>ایمیل: <a class="ltr" href={`mailto:${email}`}>{email}</a></li>}
            {whatsapp && <li><a href={whatsapp} rel="noopener">پیام در واتساپ</a></li>}
            {telegram && <li><a href={telegram} rel="noopener">پیام در تلگرام</a></li>}
          </ul>
        </aside>
      )}
    </div>
  </Section>
</PageLayout>

<style>
  .layout { display: grid; gap: var(--s-12); max-width: 56rem; }
  aside h2 { font-size: var(--fs-h3); margin-bottom: var(--s-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  a { color: var(--accent); }
  @media (min-width: 64rem) { .layout:has(aside) { grid-template-columns: 1.4fr 1fr; max-width: none; } }
</style>
