---
// صفحه درباره من. اگر فایل src/assets/about/photo.(jpg|jpeg|png|webp) وجود داشته باشد، نمایش داده می‌شود.
import { Image } from "astro:assets";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/common/Section.astro";
import Button from "../components/common/Button.astro";
import { siteFor } from "../data/site";
import { fmt, useI18n } from "../i18n/ui";
import { hasEntries } from "../utils/content";
import { ownerPhoto } from "../utils/photo";

const { lang, t, lp } = useI18n(Astro.url);
const site = siteFor(lang);
const a = t.about;
const hasWork = await hasEntries("portfolio");
const photo = ownerPhoto;
---

<PageLayout
  title={a.title}
  description={fmt(a.description, { owner: site.owner })}
  heading={fmt(a.heading, { owner: site.owner })}
  lead={a.lead}
  crumbs={[{ label: a.title }]}
>
  <Section>
    <div class="layout">
      {photo && <Image src={photo} alt={site.owner} widths={[320, 640]} sizes="320px" class="photo" />}
      <div class="text">
        <h2>{a.h1}</h2>
        <p>{a.p1}</p>

        <h2>{a.h2}</h2>
        <p>{a.p2}</p>

        <h2>{a.h3}</h2>
        <ul>
          {a.list.map((item) => <li>{item}</li>)}
        </ul>

        <div class="actions">
          <Button href={site.primaryCta.href}>{site.primaryCta.label}</Button>
          {hasWork
            ? <Button href={lp("/portfolio/")} variant="secondary">{a.portfolio}</Button>
            : <Button href={lp("/design/")} variant="secondary">{a.design}</Button>}
        </div>
      </div>
    </div>
  </Section>
</PageLayout>

<style>
  .layout { display: grid; gap: var(--s-8); align-items: start; }
  .photo { width: 100%; max-width: 20rem; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-md); }
  .text { max-width: var(--measure); }
  h2 { font-size: var(--fs-h3); margin: var(--s-8) 0 var(--s-2); }
  h2:first-child { margin-top: 0; }
  p { color: var(--muted); }
  ul { padding-inline-start: var(--s-6); color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-8); }
  @media (min-width: 48rem) { .layout:has(.photo) { grid-template-columns: 20rem 1fr; } }
</style>
